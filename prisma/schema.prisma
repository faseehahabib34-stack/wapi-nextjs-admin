
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ADMIN
model AdminUser {
  id             Int       @id @default(autoincrement())
  email          String    @unique @db.VarChar(191)
  passwordHash   String    @db.VarChar(255)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())

  @@map("adminuser")
}

// GLOBAL SETTINGS
model SiteSetting {
  id             Int      @id @default(1)
  logo           String?  @db.VarChar(1000)
  logoAlt        String?  @db.VarChar(1000)
  whatsappNumber String?  @db.VarChar(40)
  phone           String?  @db.VarChar(1000)
  email           String?  @db.VarChar(1000)
  address         String?  @db.Text
  defaultOgImage  String?  @db.VarChar(1000)
  updatedAt       DateTime @updatedAt

  @@map("sitesetting")
}

model HeaderSetting {
  id                 Int      @id @default(1)
  ctaText            String?  @db.VarChar(1000)
  ctaLink            String?  @db.VarChar(1000)
  loginText          String?  @db.VarChar(1000)
  loginLink          String?  @db.VarChar(1000)
  dropdownLabel      String?  @db.VarChar(1000)
  dropdownLink       String?  @db.VarChar(1000)
  mobileCtaText      String?  @db.VarChar(1000)
  mobileWhatsappText String?  @db.VarChar(1000)
  updatedAt          DateTime @updatedAt

  @@map("headersetting")
}

model FooterSetting {
  id             Int      @id @default(1)
  title          String?  @db.VarChar(1000)
  text           String?  @db.Text
  productTitle   String?  @db.VarChar(1000)
  solutionsTitle String?  @db.VarChar(1000)
  companyTitle   String?  @db.VarChar(1000)
  copyright      String?  @db.VarChar(1000)
  trademark      String?  @db.VarChar(1000)
  ctaText        String?  @db.VarChar(1000)
  ctaLink        String?  @db.VarChar(1000)
  updatedAt      DateTime @updatedAt

  @@map("footersetting")
}

model MenuItem {
  id           Int     @id @default(autoincrement())
  group        String  @db.VarChar(40)
  label        String  @db.VarChar(120)
  href         String  @db.VarChar(255)
  openInNewTab Boolean @default(false)
  sortOrder    Int     @default(0)
  published    Boolean @default(true)

  @@index([group, sortOrder])
  @@map("menuitem")
}

model DemoFormSetting {
  id                 Int                @id @default(1)
  title              String?            @db.VarChar(1000)
  subtitle           String?            @db.VarChar(1000)
  namePlaceholder    String?            @db.VarChar(1000)
  companyPlaceholder String?            @db.VarChar(1000)
  phonePlaceholder   String?            @db.VarChar(1000)
  interestDefault    String?            @db.VarChar(1000)
  button             String?            @db.VarChar(1000)
  note               String?            @db.VarChar(1000)
  whatsappMessage    String?            @db.VarChar(1000)
  updatedAt          DateTime           @updatedAt
  interests          DemoFormInterest[]

  @@map("demoformsetting")
}

model DemoFormInterest {
  id        Int             @id @default(autoincrement())
  formId    Int             @default(1)
  label     String          @db.VarChar(1000)
  sortOrder Int             @default(0)
  form      DemoFormSetting @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, sortOrder])
  @@map("demoforminterest")
}

model Lead {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(120)
  company   String   @db.VarChar(120)
  phone     String   @db.VarChar(60)
  interest  String   @db.VarChar(120)
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("lead")
}

// PAGES
model Page {
  id          Int              @id @default(autoincrement())
  slug        String           @unique @db.VarChar(60)
  label       String           @db.VarChar(120)
  path        String           @db.VarChar(255)
  sortOrder   Int              @default(0)
  seo         PageSeo?
  hero        PageHero?
  cta         PageCta?
  subnavItems PageSubnavItem[]
  faqGroups   FaqGroup[]
  sections    PageSection[]

  @@map("page")
}

model PageSeo {
  id            Int      @id @default(autoincrement())
  pageId        Int      @unique
  title         String?  @db.VarChar(1000)
  description   String?  @db.Text
  ogTitle       String?  @db.VarChar(1000)
  ogDescription String?  @db.Text
  ogImage       String?  @db.VarChar(1000)
  canonical     String?  @db.VarChar(1000)
  keywords      String?  @db.VarChar(1000)
  noindex       Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("pageseo")
}

model PageHero {
  id              Int      @id @default(autoincrement())
  pageId          Int      @unique
  title           String?  @db.VarChar(1000)
  titleStart      String?  @db.VarChar(1000)
  titleGradient   String?  @db.VarChar(1000)
  titleEnd        String?  @db.VarChar(1000)
  lead            String?  @db.Text
  sub             String?  @db.Text
  primaryButton   String?  @db.VarChar(1000)
  secondaryButton String?  @db.VarChar(1000)
  updatedAt       DateTime @updatedAt
  page            Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("pagehero")
}

model PageCta {
  id        Int      @id @default(autoincrement())
  pageId    Int      @unique
  title     String?  @db.VarChar(1000)
  text1     String?  @db.Text
  text2     String?  @db.Text
  updatedAt DateTime @updatedAt
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("pagecta")
}

model PageSubnavItem {
  id        Int    @id @default(autoincrement())
  pageId    Int
  anchor    String @db.VarChar(40)
  label     String @db.VarChar(1000)
  sortOrder Int    @default(0)
  page      Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, anchor])
  @@map("pagesubnavitem")
}

model FaqGroup {
  id        Int     @id @default(autoincrement())
  pageId    Int
  heading   String? @db.VarChar(1000)
  sortOrder Int     @default(0)
  page      Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  faqs      Faq[]

  @@index([pageId])
  @@map("faqgroup")
}

model Faq {
  id        Int      @id @default(autoincrement())
  groupId   Int
  question  String   @db.VarChar(255)
  answer    String   @db.Text
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  group     FaqGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("faq")
}

model PageSection {
  id        Int            @id @default(autoincrement())
  pageId    Int
  code      String         @db.VarChar(20)
  title     String         @db.VarChar(120)
  sortOrder Int            @default(0)
  visible   Boolean        @default(true)
  page      Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  texts     SectionText[]
  links     SectionLink[]
  icons     SectionIcon[]
  images    SectionImage[]

  @@unique([pageId, code])
  @@map("pagesection")
}

model SectionText {
  id        Int         @id @default(autoincrement())
  sectionId Int
  code      String      @db.VarChar(20)
  value     String      @db.Text
  updatedAt DateTime    @updatedAt
  section   PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, code])
  @@map("sectiontext")
}

model SectionLink {
  id        Int         @id @default(autoincrement())
  sectionId Int
  code      String      @db.VarChar(20)
  href      String      @db.VarChar(1000)
  updatedAt DateTime    @updatedAt
  section   PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, code])
  @@map("sectionlink")
}

model SectionIcon {
  id        Int         @id @default(autoincrement())
  sectionId Int
  code      String      @db.VarChar(20)
  icon      String      @db.VarChar(60)
  updatedAt DateTime    @updatedAt
  section   PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, code])
  @@map("sectionicon")
}

model SectionImage {
  id        Int         @id @default(autoincrement())
  sectionId Int
  code      String      @db.VarChar(20)
  url       String      @db.VarChar(1000)
  updatedAt DateTime    @updatedAt
  section   PageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, code])
  @@map("sectionimage")
}

// MEDIA
model Media {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(100)
  mimeType  String   @db.VarChar(60)
  size      Int
  data      Bytes    @db.LongBlob
  createdAt DateTime @default(now())

  @@map("media")
}

// PRICING
enum PlanStyle {
  DEFAULT
  POPULAR
  DARK
}

model PricingPlan {
  id              Int              @id @default(autoincrement())
  name            String           @db.VarChar(120)
  tagline         String           @db.VarChar(255)
  description     String           @db.Text
  price           String           @db.VarChar(120)
  priceSuffix     String           @db.VarChar(60)
  buttonText      String           @db.VarChar(120)
  buttonLink      String           @db.VarChar(255)
  featuresHeading String           @db.VarChar(120)
  style           PlanStyle        @default(DEFAULT)
  sortOrder       Int              @default(0)
  published       Boolean          @default(true)
  features        PricingFeature[]

  @@map("pricingplan")
}

model PricingFeature {
  id        Int         @id @default(autoincrement())
  text      String      @db.VarChar(255)
  sortOrder Int         @default(0)
  planId    Int
  plan      PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("pricingfeature")
}

// LEGACY CONTENT
model LegacyContent {
  key       String   @id @db.VarChar(191)
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("content")
}
